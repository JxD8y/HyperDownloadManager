<Page x:Class="HyperDownloadManager.Views.Downloads"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:HyperDownloadManager.Views"
      xmlns:ViewModels="clr-namespace:HyperDownloadManager.ViewModels.Download"
      mc:Ignorable="d" 
      xmlns:xico="http://metro.mahapps.com/winfx/xaml/iconpacks"
      xmlns:HDMControl="clr-namespace:HyperDownloadManager.Styles.Controls.CustomControls"
      d:DesignHeight="554" d:DesignWidth="900"
      Title="Downloads" Background="{DynamicResource BackgroundBrush}">
    <Grid FocusVisualStyle="{x:Null}" x:Name="maingrid" Margin="0 2 0 0">
        <Grid.RowDefinitions>
            <RowDefinition Height="85"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Grid.Column="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Margin="5 10 0 10" HorizontalAlignment="Left" Orientation="Horizontal">
                <StackPanel Orientation="Horizontal">
                    <Border Width="45" Background="#037c52" CornerRadius="10 0 0 10" x:Name="addNew" Margin="5 10 0 10" MouseLeftButtonDown="addNew_Click">
                        <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                            <Label HorizontalAlignment="Center" Content="{xico:Material Kind=Plus,Width=25,Height=25}" Foreground="White"/>
                        </StackPanel>
                    </Border>
                    <Border Width="45" Background="{DynamicResource BoxBrush}" CornerRadius="0" x:Name="DelDownload" MouseLeftButtonDown="DelDownload_MouseLeftButtonDown" Margin="0 10 0 10">
                        <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                            <Label HorizontalAlignment="Center" Content="{xico:Material Kind=Delete, Width=25,Height=25}" Foreground="IndianRed" Opacity="{Binding ElementName=DelDownload, Path=IsEnabled , Converter={StaticResource BoolToOpacity}}"/>
                        </StackPanel>
                    </Border>
                    <Border Width="45" x:Name="stateButton" Background="{DynamicResource BoxBrush}" CornerRadius="0 10 10 0" Margin="0 10 5 10">
                        <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                            <Label HorizontalAlignment="Center" Content="{xico:Material Kind=Pause, Width=25,Height=25}" x:Name="PauseButton" Foreground="Orange" Opacity="{Binding ElementName=stateButton, Path=IsEnabled , Converter={StaticResource BoolToOpacity}}"/>
                            <Label HorizontalAlignment="Center" Content="{xico:Material Kind=Play, Width=25,Height=25}" x:Name="PlayButton" Foreground="SeaGreen" Visibility="{Binding ElementName=PauseButton,Path=Visibility,Converter={StaticResource ReverseVisiblity}}" Opacity="{Binding ElementName=stateButton, Path=IsEnabled , Converter={StaticResource BoolToOpacity}}"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource BoxBrush}" Margin="0 10 10 10" CornerRadius="10">
                        <StackPanel Orientation="Horizontal" Margin="5 0 0 0">
                            <ComboBox Style="{DynamicResource buttoncombo}" x:Name="ContainerCombo" SelectionChanged="ContainerCombo_SelectionChanged" MaxWidth="220" SelectedIndex="0" ItemsSource="{Binding}" Margin="5 10 20 10" HorizontalAlignment="Center" Background="{DynamicResource ObsoleteBrush}">
                                <ComboBox.Tag>
                                    <Button Content="Add New Container" x:Name="containerAdd" Click="containerAdd_Click"/>
                                </ComboBox.Tag>
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Label Content="{Binding Name}" Visibility="{Binding IsMain,Converter={StaticResource BooltoReverseVisiblity}}"/>
                                            <Label Content="{xico:BootstrapIcons Kind=Stack}" Foreground="{DynamicResource AccentBrush}" Visibility="{Binding IsMain,Converter={StaticResource BooltoVisiblity}}"/>
                                            <StackPanel.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem x:Name="ContainerRunAllMenuItem" Click="ContainerRunAllMenuItem_Click" Tag="{Binding Id}">
                                                        <MenuItem.Header>
                                                            <StackPanel Orientation="Horizontal">
                                                                <Label Content="{xico:Material Kind=PlayCircle}"/>
                                                                <TextBlock Text="Run All Download" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </MenuItem.Header>
                                                    </MenuItem>
                                                    <Separator/>
                                                    <MenuItem Visibility="{Binding IsMain,Converter={StaticResource BooltoReverseVisiblity}}" x:Name="ContainerRemoveMenuItem" Click="ContainerRemoveMenuItem_Click" Tag="{Binding Id}">
                                                        <MenuItem.Header>
                                                            <StackPanel Orientation="Horizontal">
                                                                <Label Content="{xico:Material Kind=Delete}" Foreground="IndianRed"/>
                                                                <TextBlock Text="Delete Container" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </MenuItem.Header>
                                                    </MenuItem>
                                                    <MenuItem x:Name="ContainerSettingMenuItem" Visibility="{Binding IsMain,Converter={StaticResource BooltoReverseVisiblity}}" Click="ContainerSettingMenuItem_Click" Tag="{Binding Id}">
                                                        <MenuItem.Header>
                                                            <StackPanel Orientation="Horizontal">
                                                                <Label Content="{xico:BootstrapIcons Kind=GearFill}"/>
                                                                <TextBlock Text="Container Settings" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </MenuItem.Header>
                                                    </MenuItem>
                                                </ContextMenu>
                                            </StackPanel.ContextMenu>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Label Content="{xico:Material Kind=Play}"/>
                            <Label Content="{Binding Actives}"/>
                            <Label Content="|" Opacity="0.5"/>
                            <Label Content="{xico:Material Kind=Pause}"/>
                            <Label Content="{Binding Paused}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
            <Border Grid.Column="1" Margin="0 20 30 20" Width="auto" CornerRadius="10" Background="{DynamicResource BoxBrush}">
                <StackPanel Orientation="Horizontal">
                    <HDMControl:LabelTextBox Width="400" HelperContent="Search Downloads" TextBoxBase.TextChanged="SearchBox_TextChanged"  x:Name="SearchBox" Margin="5 1 0 0"/>
                    <Label Content="{xico:Material Kind=Magnify}"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border CornerRadius="10" Background="{DynamicResource BoxBrush}" FocusVisualStyle="{x:Null}" Margin="5,0,5,0" Grid.Row="1" >
            <Grid x:Name="MainDownloadGrid" AllowDrop="True">
                <ScrollViewer x:Name="DownloadScroller" PreviewMouseLeftButtonDown="DownloadScroller_PreviewMouseLeftButtonDown" VerticalScrollBarVisibility="Auto" Margin="0 5 0 0" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="downloadscontainer">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <ItemContainerTemplate>
                                <Border BorderBrush="{Binding CurrentState,Converter={StaticResource DownloadStatetoBrush}}" Background="{DynamicResource BackgroundBrush}" Height="30" MouseLeftButtonDown="ShowDownloadDetail" BorderThickness="1" Margin="5 2 5 2" Tag="{Binding Id}" CornerRadius="3">
                                    <Grid>
                                        <ProgressBar Foreground="{Binding CurrentState,Converter={StaticResource DownloadStatetoBrush}}" VerticalAlignment="Center" Opacity="0.9" Value="{Binding Current_Percent}" Background="{Binding Selected,Converter={StaticResource BooltoBrush}}" BorderThickness="0" Height="70" MinWidth="450"/>
                                        <Grid>
                                            <StackPanel Orientation="Horizontal" Panel.ZIndex="1" Opacity="1">
                                                <Image Source="{Binding Icon}" Width="25" Height="25" Margin="10 0 10 0"/>
                                                <Label Content="{Binding DownloadName}" MaxWidth="700" Foreground="{DynamicResource ForegroundBrush}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 0 10 0">
                                                <Label Content="{xico:BootstrapIcons Kind=Dot,Width=10,Height=10}" Foreground="{Binding CurrentState,Converter={StaticResource DownloadStatetoBrush}}" VerticalAlignment="Center">
                                                    <Label.Style>
                                                        <Style TargetType="Label">
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding CurrentState}" Value="{x:Static ViewModels:DownloadState.Downloading}"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <MultiDataTrigger.EnterActions>
                                                                        <BeginStoryboard x:Name="BlinkingStoryBoard">
                                                                            <Storyboard FillBehavior="Stop" RepeatBehavior="Forever" AutoReverse="True">
                                                                                <DoubleAnimation From="1" To="0" Duration="0:0:0.5" Storyboard.TargetProperty="Opacity"/>
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </MultiDataTrigger.EnterActions>
                                                                    <MultiDataTrigger.ExitActions>
                                                                        <StopStoryboard BeginStoryboardName="BlinkingStoryBoard"/>
                                                                    </MultiDataTrigger.ExitActions>
                                                                </MultiDataTrigger>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding CurrentState}" Value="{x:Static ViewModels:DownloadState.Error}"/>
                                                                        <Condition Binding="{Binding CurrentState}" Value="{x:Static ViewModels:DownloadState.Paused}"/>
                                                                        <Condition Binding="{Binding CurrentState}" Value="{x:Static ViewModels:DownloadState.Completed}"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <MultiDataTrigger.EnterActions>
                                                                        <BeginStoryboard>
                                                                            <Storyboard>
                                                                                <DoubleAnimation From="0" To="1" Duration="0:0:0.1" Storyboard.TargetProperty="Opacity"/>
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </MultiDataTrigger.EnterActions>
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Label.Style>
                                                </Label>
                                                <Label Content="{Binding CurrentState}" Margin="-2 0 10 0" Foreground="{Binding CurrentState,Converter={StaticResource DownloadStatetoBrush}}" VerticalAlignment="Center"/>
                                                <Label Content="{xico:Material Kind=Timer}" Foreground="{DynamicResource ForegroundBrush}" VerticalAlignment="Center"/>
                                                <Label Content="{Binding RemainingTime ,Converter={StaticResource TimeSpantoString}}" Foreground="{DynamicResource ForegroundBrush}" VerticalAlignment="Center"/>
                                                <Label Content="{xico:Material Kind=Speedometer}" Foreground="{DynamicResource ForegroundBrush}" VerticalAlignment="Center"/>
                                                <Label Content="{Binding CurrentSpeed.DataValue,Converter={StaticResource FloattoString}}" Foreground="{DynamicResource ForegroundBrush}"/>
                                                <Label Content="{Binding CurrentSpeed.DataUnit}" Foreground="{DynamicResource ForegroundBrush}"/>
                                                <Label Content="/s" Foreground="{DynamicResource ForegroundBrush}"/>
                                                <Label Content="{xico:Material Kind=Play}" Foreground="SeaGreen" x:Name="StartDownload" Tag="{Binding Id}" MouseLeftButtonDown="StartDownload_MouseLeftButtonDown" Visibility="{Binding Supervisor.IsWorking,Converter={StaticResource BooltoReverseVisiblity}}"/>
                                                <Label Content="{xico:Material Kind=Pause}" Foreground="Orange" x:Name="PauseDownload" Tag="{Binding Id}" MouseLeftButtonDown="PauseDownload_MouseLeftButtonDown"  Visibility="{Binding Visibility, ElementName=StartDownload,Converter={StaticResource ReverseVisiblity}}"/>
                                            </StackPanel>
                                        </Grid>
                                        <Grid.ContextMenu>
                                            <ContextMenu Width="300">
                                                <MenuItem IsEnabled="False">
                                                    <MenuItem.Header>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Label Content="{xico:Material Kind=FileSwap}" Foreground="{DynamicResource ForegroundBrush}"/>
                                                            <Label Content="Downloaded: " Foreground="{DynamicResource ForegroundBrush}"/>
                                                            <Label Content="{Binding DownloadedSize.DataValue ,Converter={StaticResource FloattoString}}" Foreground="{DynamicResource ForegroundBrush}"/>
                                                            <Label Content="{Binding DownloadedSize.DataUnit}" Foreground="{DynamicResource ForegroundBrush}"/>
                                                        </StackPanel>
                                                    </MenuItem.Header>
                                                </MenuItem>
                                                <MenuItem IsEnabled="False">
                                                    <MenuItem.Header>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Label Content="{xico:Material Kind=FileDownload}" Foreground="{DynamicResource ForegroundBrush}"/>
                                                            <Label Content="File Size: " Foreground="{DynamicResource ForegroundBrush}"/>
                                                            <Label Content="{Binding FileSize.DataValue,Converter={StaticResource FloattoString}}" x:Name="filesize" Foreground="{DynamicResource ForegroundBrush}"/>
                                                            <Label Content="{Binding FileSize.DataUnit}" x:Name="Filesizeunit" Foreground="{DynamicResource ForegroundBrush}"/>
                                                        </StackPanel>
                                                    </MenuItem.Header>
                                                </MenuItem>
                                                <MenuItem IsEnabled="False">
                                                    <MenuItem.Header>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Label Content="{xico:Material Kind=FilePercent}" Foreground="{DynamicResource ForegroundBrush}"/>
                                                            <Label Content="Percent: " Foreground="{DynamicResource ForegroundBrush}"/>
                                                            <Label Content="{Binding Current_Percent,Converter={StaticResource FloattoString}}" Margin="5 0 0 0" Foreground="{DynamicResource ForegroundBrush}"/>
                                                            <Label Content="%" Margin="0 0 0 0" Foreground="{DynamicResource ForegroundBrush}"/>
                                                        </StackPanel>
                                                    </MenuItem.Header>
                                                </MenuItem>
                                                <MenuItem IsEnabled="False">
                                                    <MenuItem.Header>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Label Content="{xico:Material Kind=AvTimer}" Foreground="{DynamicResource ForegroundBrush}"/>
                                                            <Label Content="Elapsed: " Foreground="{DynamicResource ForegroundBrush}"/>
                                                            <Label Content="{Binding ElapsedTime, Converter={StaticResource TimeSpantoString}}" Foreground="{DynamicResource ForegroundBrush}"/>
                                                        </StackPanel>
                                                    </MenuItem.Header>
                                                </MenuItem>
                                                <MenuItem IsEnabled="False" Visibility="{Binding Supervisor.ErrorOccurred,Converter={StaticResource BooltoVisiblity}}">
                                                    <MenuItem.Header>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Label Content="{xico:Material Kind=Alert}" Foreground="Orange"/>
                                                            <Label Content="{Binding Supervisor.ErrorString}" Foreground="{DynamicResource ForegroundBrush}"/>
                                                        </StackPanel>
                                                    </MenuItem.Header>
                                                </MenuItem>
                                                <Separator/>
                                                <MenuItem x:Name="pauseLabelContext" Tag="{Binding Id}" Visibility="{Binding Supervisor.IsWorking,Converter={StaticResource BooltoVisiblity}}" Click="pauseLabelContext_Click">
                                                    <MenuItem.Header>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Label Content="{xico:Material Kind=Pause}" Foreground="Orange"/>
                                                            <Label Content="Pause" Foreground="{DynamicResource ForegroundBrush}"/>
                                                        </StackPanel>
                                                    </MenuItem.Header>
                                                </MenuItem>
                                                <MenuItem x:Name="startLabelContext" Tag="{Binding Id}" Visibility="{Binding Supervisor.IsWorking,Converter={StaticResource BooltoReverseVisiblity}}" Click="startLabelContext_Click">
                                                    <MenuItem.Header>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Label Content="{xico:Material Kind=Play}" Foreground="SeaGreen" />
                                                            <Label Content="Start" Foreground="{DynamicResource ForegroundBrush}"/>
                                                        </StackPanel>
                                                    </MenuItem.Header>
                                                </MenuItem>
                                                <MenuItem x:Name="downloadSettingsContext" Click="downloadSettingsContext_Click" Tag="{Binding Id}">
                                                    <MenuItem.Header>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Label Content="{xico:BootstrapIcons Kind=GearFill}" Foreground="{StaticResource AccentBrush}"/>
                                                            <Label Content="Settings" Foreground="{DynamicResource ForegroundBrush}"/>
                                                        </StackPanel>
                                                    </MenuItem.Header>
                                                </MenuItem>
                                            </ContextMenu>
                                        </Grid.ContextMenu>
                                    </Grid>
                                </Border>
                            </ItemContainerTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Page>

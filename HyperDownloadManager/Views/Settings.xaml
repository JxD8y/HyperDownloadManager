<Page x:Class="HyperDownloadManager.Views.Settings"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:HyperDownloadManager.Views"
      xmlns:xico="http://metro.mahapps.com/winfx/xaml/iconpacks"
      mc:Ignorable="d" 
      d:DesignHeight="641" d:DesignWidth="353"
      Title="Settings" Background="Transparent">

    <Border BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource BackgroundBrush}" BorderThickness=".5" CornerRadius="15">
        <Grid Background="Transparent" Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="35"/>
                <RowDefinition/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>
            <StackPanel x:Name="Toppanel_stack" Orientation="Horizontal">
                <Label Content="General Settings" Foreground="{DynamicResource ForegroundBrush}" x:Name="General" MouseLeftButtonDown="Settings_MouseLeftButtonDown"/>
                <Label Content="Network Settings" Foreground="{DynamicResource ForegroundBrush}" x:Name="Network" MouseLeftButtonDown="Settings_MouseLeftButtonDown"/>
                <Label Content="Theme Settings" Foreground="{DynamicResource ForegroundBrush}" x:Name="Theme" MouseLeftButtonDown="Settings_MouseLeftButtonDown"/>
            </StackPanel>
            <ScrollViewer Grid.Row="1" Grid.RowSpan="1" VerticalScrollBarVisibility="Visible">
                <Frame x:Name="settingFrame" NavigationUIVisibility="Hidden"/>
            </ScrollViewer>
            <StackPanel x:Name="ControlPanel" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 10 0 0">
                <Button x:Name="RestoreButton" Click="RestoreButton_Click" Margin="5">
                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                        <Label Content="{xico:Material Kind=Refresh}" Foreground="Orange"/>
                        <Label Content="Restore Default"/>
                    </StackPanel>
                </Button>
                <Button x:Name="SaveButton" Click="SaveButton_Click" Margin="5">
                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                        <Label Content="{xico:Material Kind=ContentSave}" Foreground="RoyalBlue"/>
                        <Label Content="Save Settings"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Page>

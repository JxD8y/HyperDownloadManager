<Page x:Class="HyperDownloadManager.Views.Pages.Setting.ThemeSettingsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:HyperDownloadManager.Views.Pages.Setting"
      xmlns:xico="http://metro.mahapps.com/winfx/xaml/iconpacks"
      mc:Ignorable="d" 
      d:DesignHeight="500" d:DesignWidth="342"
      Title="ThemeSettingsView" Background="{DynamicResource BackgroundBrush}">

    <Grid>
        <Label Content="{xico:BootstrapIcons Kind=MoonStarsFill, Height=100 ,Width=100}" MouseLeftButtonDown="night_MouseLeftButtonDown" x:Name="night" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        <Label Content="{xico:BootstrapIcons Kind=SunFill, Height=100 ,Width=100}" MouseLeftButtonDown="day_MouseLeftButtonDown" x:Name="day" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="Orange"/>
    </Grid>
</Page>

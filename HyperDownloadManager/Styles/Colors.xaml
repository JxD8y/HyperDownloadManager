<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="WBorderColor" >#36636b</Color>
    <Color x:Key="WBackgroundColor">#fff</Color>
    <Color x:Key="WForegroundColor">#212121</Color>
    <Color x:Key="WSecondryColor">#d7d7d7</Color>
    <Color x:Key="WPrimaryColor">#0165b2</Color>
    <Color x:Key="WBoxColor">#efefef</Color>
    <Color x:Key="WObsoleteColor">#d1d2d3</Color>

    <Color x:Key="DBorderColor" >#7a7a7a</Color>
    <Color x:Key="DBackgroundColor">#111111</Color>
    <Color x:Key="DForegroundColor">#f8f9fa</Color>
    <Color x:Key="DSecondryColor">#232323</Color>
    <Color x:Key="DPrimaryColor">#0491d3</Color>
    <Color x:Key="DObsoleteColor">#464646</Color>
    <Color x:Key="DBoxColor">#222</Color>

    <Color x:Key="AccentColor">#1b63d6</Color>
    <Color x:Key="VColor">#7b37ba</Color>

    
    <SolidColorBrush x:Shared="False" x:Key="AccentBrush" Color="{DynamicResource AccentColor}"/>
    <SolidColorBrush x:Shared="False" x:Key="BorderBrush" Color="{DynamicResource DBorderColor}"/>
    <SolidColorBrush x:Shared="False" x:Key="BackgroundBrush" Color="{DynamicResource DBackgroundColor}"/>
    <SolidColorBrush x:Shared="False" x:Key="ForegroundBrush" Color="{StaticResource DForegroundColor}"/>
    <SolidColorBrush x:Shared="False" x:Key="SecondaryBrush" Color="{DynamicResource DSecondryColor}"/>
    <SolidColorBrush x:Shared="False" x:Key="PrimaryBrush" Color="{DynamicResource DPrimaryColor}"/>
    <SolidColorBrush x:Shared="False" x:Key="ObsoleteBrush" Color="{DynamicResource DObsoleteColor}"/>
    <SolidColorBrush x:Shared="False" x:Key="BoxBrush" Color="{DynamicResource DBoxColor}"/>

</ResourceDictionary>
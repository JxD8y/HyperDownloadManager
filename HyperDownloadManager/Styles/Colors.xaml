<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="WBorderColor" >#3f3333</Color>
    <Color x:Key="WBackgroundColor">#ffa8ae</Color>
    <Color x:Key="WForegroundColor">#212529</Color>
    <Color x:Key="WSecondryColor">#bc7e7f</Color>
    <Color x:Key="WPrimaryColor">#7f5e5e</Color>
    <Color x:Key="WBoxColor">#dd8282</Color>
    <Color x:Key="WObsoleteColor">#db5e60</Color>

    <Color x:Key="DBorderColor" >#83a1bf</Color>
    <Color x:Key="DBackgroundColor">#111a23</Color>
    <Color x:Key="DForegroundColor">#f8f9fa</Color>
    <Color x:Key="DSecondryColor">#23394f</Color>
    <Color x:Key="DPrimaryColor">#4583c1</Color>
    <Color x:Key="DObsoleteColor">#1d3042</Color>
    <Color x:Key="DBoxColor">#0f2133</Color>

    <Color x:Key="AccentColor">#6d91ff</Color>
    <Color x:Key="VColor">#7b37ba</Color>


    <SolidColorBrush x:Key="BorderBrush" Color="{DynamicResource DBorderColor}"/>
    <SolidColorBrush x:Key="BackgroundBrush" Color="{DynamicResource DBackgroundColor}"/>
    <SolidColorBrush x:Key="ForegroundBrush" Color="{DynamicResource DForegroundColor}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{DynamicResource DSecondryColor}"/>
    <SolidColorBrush x:Key="PrimaryBrush" Color="{DynamicResource DPrimaryColor}"/>
    <SolidColorBrush x:Key="ObsoleteBrush" Color="{DynamicResource DObsoleteColor}"/>
    <SolidColorBrush x:Key="BoxBrush" Color="{DynamicResource DBoxColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}"/>
    
</ResourceDictionary>
<MahApps:MetroWindow x:Class="HyperDownloadManager.Dialogs.DialogBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HyperDownloadManager.Dialogs"
        xmlns:MahApps="http://metro.mahapps.com/winfx/xaml/controls"
        mc:Ignorable="d"
        Title="HDM Dialog" WindowTransitionsEnabled="False" GlowBrush="{x:Null}" SnapsToDevicePixels="True" UseLayoutRounding="True" Height="170" Width="400" WindowStartupLocation="CenterScreen" Topmost="True" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Foreground="{DynamicResource ForegroundBrush}" TitleBarHeight="30" ResizeMode="NoResize" WindowStyle="SingleBorderWindow">
    <MahApps:MetroWindow.WindowButtonCommands>
        <MahApps:WindowButtonCommands LightCloseButtonStyle="{DynamicResource LightMetroControl}" DarkCloseButtonStyle="{DynamicResource DarkMetroControl}" LightMinButtonStyle="{DynamicResource DarkMetroControl}" DarkMinButtonStyle="{DynamicResource DarkMetroControl}" LightMaxButtonStyle="{DynamicResource DarkMetroControl}" DarkMaxButtonStyle="{DynamicResource DarkMetroControl}"/>
    </MahApps:MetroWindow.WindowButtonCommands>
    <Grid>
        <Frame x:Name="Mainframe" NavigationUIVisibility="Hidden"/>
    </Grid>
</MahApps:MetroWindow>
